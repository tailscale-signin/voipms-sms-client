<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/thread_gutter"
    android:layout_marginTop="@dimen/conversation_item_margin_top_primary"
    android:layout_marginEnd="@dimen/thread_gutter"
    android:orientation="vertical">

    <TextView
        android:id="@+id/top_date"
        android:layout_width="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/date_chip"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/message_hint"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/half_margin"
        android:gravity="center"
        android:textAppearance="@style/Caption"
        android:visibility="gone" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/placeholder"
            android:layout_width="@dimen/contact_badge"
            android:layout_height="@dimen/contact_badge"
            android:layout_alignParentStart="true"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/margin" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_gravity="bottom"
            android:layout_toEndOf="@id/placeholder"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/sms_container"
                android:background="@drawable/bubble_outgoing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:minHeight="@dimen/contact_badge"
                android:orientation="vertical"
                android:padding="@dimen/sms_container_padding">

                <TextView
                    android:id="@+id/message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Body1"
                    android:textColor="@color/on_message_outgoing"
                    android:textColorLink="@color/on_message_outgoing" />

                <LinearLayout
                    android:id="@+id/message_attachments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <include layout="@layout/copy_sms_code" />
            </LinearLayout>

            <TextView
                android:id="@+id/date"
                android:layout_marginTop="3dp"
                android:textColor="@color/message_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:maxLines="1"
                android:textAppearance="@style/Caption"
                android:visibility="gone" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
