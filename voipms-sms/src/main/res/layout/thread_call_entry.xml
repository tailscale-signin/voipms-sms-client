<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginStart="@dimen/margin"
    android:layout_marginEnd="@dimen/margin" android:padding="@dimen/margin"
    android:gravity="center_horizontal">
    <TextView android:id="@+id/call_entry_name" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textAppearance="@style/Body1"/>
    <TextView android:id="@+id/call_entry_time" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textAppearance="@style/Caption"/>
    <FrameLayout android:id="@+id/call_entry_controls" android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
